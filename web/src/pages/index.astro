---
import SiteLayout from '../layouts/SiteLayout.astro';
import EvidenceBars from '../components/EvidenceBars.astro';
import { studies, evidenceCutoff } from '../content/studies.mjs';
import { publicDocuments } from '../content/public-documents.mjs';
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Independent quantitative deep-learning research">
  <div class="container">
    <section class="hero">
      <div>
        <span class="eyebrow" data-i18n-en="Models from market structure · evidence before claims" data-i18n-zh="从市场结构中学习 · 结论以证据为准">Models from market structure · evidence before claims</span>
        <h1 data-i18n-en="Can neural networks find useful signals in market data?" data-i18n-zh="神经网络能从市场数据中找到有用信号吗？">Can neural networks find useful signals in market data?</h1>
        <p data-i18n-en="This project studies models that learn directly from order-book snapshots, minute sequences, and market events. The short version so far: some models rank stocks better than chance, but that does not yet mean they make money after costs." data-i18n-zh="本项目研究直接从盘口快照、分钟序列和市场事件中学习的模型。当前结论是：部分模型的股票排序优于随机水平，但这还不代表扣除成本后能够赚钱。">This project studies models that learn directly from order-book snapshots, minute sequences, and market events. The short version so far: some models rank stocks better than chance, but that does not yet mean they make money after costs.</p>
        <div class="button-row"><a class="button primary" href={`${base}studies/`} data-i18n-en="Explore the studies" data-i18n-zh="浏览研究结果">Explore the studies</a><a class="button" href={`${base}documentation/`} data-i18n-en="Read methods and code docs" data-i18n-zh="查看方法与技术文档">Read methods and code docs</a></div>
      </div>
      <aside class="hero-note"><strong data-i18n-en="How to read this site" data-i18n-zh="如何阅读本站结果">How to read this site</strong><span data-i18n-en={`Each result names its sample, evidence stage, and open question. A positive Rank IC means rankings line up with later returns; it is not a portfolio return. The site summarizes records through ${evidenceCutoff}.`} data-i18n-zh={`每项结果都会说明样本范围、证据阶段和待回答的问题。Rank IC为正表示模型排序与之后的收益排序存在正相关；它不等于组合收益。本站内容截至 ${evidenceCutoff}。`}>Each result names its sample, evidence stage, and open question. A positive Rank IC means rankings line up with later returns; it is not a portfolio return. The site summarizes records through {evidenceCutoff}.</span></aside>
    </section>

    <section class="section">
      <div class="section-heading"><div><span class="eyebrow" data-i18n-en="Research in one minute" data-i18n-zh="一分钟了解研究">Research in one minute</span><h2 data-i18n-en="What the evidence says today" data-i18n-zh="现有证据说明了什么">What the evidence says today</h2></div><p data-i18n-en="The main pattern is separation: ranking metrics can look useful while simulated portfolios still lose after costs." data-i18n-zh="目前最重要的发现是：排序指标看起来不错时，模拟组合仍可能在计入成本后亏损。">The main pattern is separation: ranking metrics can look useful while simulated portfolios still lose after costs.</p></div>
      <div class="grid-3">
        {studies.map((study) => <a class="card card-link" href={`${base}studies/${study.id}/`}><span class={`status ${study.id === 'minute-baselines' ? 'caution' : ''}`} data-i18n-en={study.stage} data-i18n-zh={study.zh.stage}>{study.stage}</span><h3 data-i18n-en={study.title} data-i18n-zh={study.zh.title}>{study.title}</h3><p data-i18n-en={study.summary} data-i18n-zh={study.zh.summary}>{study.summary}</p><span class="source-note" data-i18n-en={study.sample} data-i18n-zh={study.zh.sample}>{study.sample}</span></a>)}
      </div>
    </section>

    <section class="section">
      <div class="section-heading"><div><span class="eyebrow" data-i18n-en="A complete research loop" data-i18n-zh="完整的研究流程">A complete research loop</span><h2 data-i18n-en="From market records to a testable result" data-i18n-zh="从市场数据到可检验的结果">From market records to a testable result</h2></div><p data-i18n-en="The model project can train and evaluate without installing the quant platform. Other systems consume its published artifacts when needed." data-i18n-zh="模型项目无需安装量化平台即可完成训练与评估。其他系统可按需读取它发布的预测产物。">The model project can train and evaluate without installing the quant platform. Other systems consume its published artifacts when needed.</p></div>
      <div class="pipeline" aria-label="Research pipeline"><div><b data-i18n-en="01 · Input" data-i18n-zh="01 · 输入">01 · Input</b><span data-i18n-en="Published market data" data-i18n-zh="已发布的市场数据">Published market data</span></div><div><b data-i18n-en="02 · Representation" data-i18n-zh="02 · 表示">02 · Representation</b><span data-i18n-en="Order book, minutes, or event stream" data-i18n-zh="盘口、分钟序列或事件流">Order book, minutes, or event stream</span></div><div><b data-i18n-en="03 · Learn" data-i18n-zh="03 · 学习">03 · Learn</b><span data-i18n-en="Train and validate models" data-i18n-zh="训练并验证模型">Train and validate models</span></div><div><b data-i18n-en="04 · Measure" data-i18n-zh="04 · 评估">04 · Measure</b><span data-i18n-en="Out-of-sample and cost checks" data-i18n-zh="样本外与成本检验">Out-of-sample and cost checks</span></div><div><b data-i18n-en="05 · Share" data-i18n-zh="05 · 发布">05 · Share</b><span data-i18n-en="Prediction artifacts for consumers" data-i18n-zh="供下游读取的预测产物">Prediction artifacts for consumers</span></div></div>
      <p class="muted" data-i18n-en="Market data is upstream. Backtest runtime is downstream. Model research stays independent of both the general-purpose quant platform and private research governance." data-i18n-zh="市场数据平台提供上游数据，回测运行时负责下游消费。模型研究独立于通用量化平台和私有研究治理系统。">Market data is upstream. Backtest runtime is downstream. Model research stays independent of both the general-purpose quant platform and private research governance.</p>
    </section>

    <section class="section">
      <div class="section-heading"><div><span class="eyebrow" data-i18n-en="Selected numbers" data-i18n-zh="关键结果">Selected numbers</span><h2 data-i18n-en="Good rankings are only the first test" data-i18n-zh="排序效果好，只是第一关">Good rankings are only the first test</h2></div><p data-i18n-en="These charts show different studies and samples. They should not be read as a head-to-head model contest." data-i18n-zh="这些图表来自不同研究和样本，不能直接作为模型之间的横向竞赛。">These charts show different studies and samples. They should not be read as a head-to-head model contest.</p></div>
      <div class="chart-grid">
        {studies.map((study) => <EvidenceBars title={study.chartTitle} description={study.chartDescription} metric={study.metric} titleZh={study.zh.chartTitle} descriptionZh={study.zh.chartDescription} metricZh={study.zh.metric} valueLabelsZh={study.zh.values} max={study.max} values={study.values} source={`${base}${study.source.replace(/^docs\//, '').replace(/\.md$/, '/')}`} />)}
      </div>
      <div class="metric-grid">
        <div class="metric"><span data-i18n-en="Joint event-stream model · OOS Rank IC" data-i18n-zh="联合事件流模型 · 样本外 Rank IC">Joint event-stream model · OOS Rank IC</span><strong>+0.06398</strong><span data-i18n-en="Positive ranking association across three seeds in one December 2025 month." data-i18n-zh="2025年12月单月的三个随机种子均呈现正向排序相关。">Positive ranking association across three seeds in one December 2025 month.</span></div>
        <div class="metric"><span data-i18n-en="Same evaluation · daily net active return" data-i18n-zh="同一评估 · 日均净超额收益">Same evaluation · daily net active return</span><strong style="color:var(--accent-dark)">−9.67 bp</strong><span data-i18n-en="Negative after costs. Ranking quality did not become profitable portfolio behavior." data-i18n-zh="计入成本后为负。排序质量没有转化为盈利的组合表现。">Negative after costs. Ranking quality did not become profitable portfolio behavior.</span></div>
        <div class="metric"><span data-i18n-en="Current research record cutoff" data-i18n-zh="当前研究记录截止日期">Current research record cutoff</span><strong>{evidenceCutoff}</strong><span data-i18n-en="Historical snapshot date, not a claim that every track has been updated today." data-i18n-zh="这是历史快照日期，并不表示所有研究方向都已更新至今天。">Historical snapshot date, not a claim that every track has been updated today.</span></div>
      </div>
      <p class="warning" data-i18n-en="Rank IC and net returns answer different questions. The event-stream values above cover limited time windows, and one positive fold cannot establish a durable edge." data-i18n-zh="Rank IC和净收益回答的是不同问题。事件流结果覆盖的时间有限，单个正向测试区间也不足以证明优势能够持续。">Rank IC and net returns answer different questions. The event-stream values above cover limited time windows, and one positive fold cannot establish a durable edge.</p>
    </section>

    <section class="section">
      <div class="section-heading"><div><span class="eyebrow" data-i18n-en="Choose a path" data-i18n-zh="按你的问题开始">Choose a path</span><h2 data-i18n-en="Start with your question" data-i18n-zh="从你关心的问题开始">Start with your question</h2></div></div>
      <div class="grid-3">
        <a class="card card-link" href={`${base}studies/`}><span class="eyebrow" data-i18n-en="For a quick overview" data-i18n-zh="快速了解">For a quick overview</span><h3 data-i18n-en="Browse research studies" data-i18n-zh="浏览研究主题">Browse research studies</h3><p data-i18n-en="See the question, conclusion, sample, evidence stage, and next open check." data-i18n-zh="查看研究问题、结论、样本、证据阶段和下一步待验证事项。">See the question, conclusion, sample, evidence stage, and next open check.</p></a>
        <a class="card card-link" href={`${base}project-status/`}><span class="eyebrow" data-i18n-en="For quantitative readers" data-i18n-zh="深入了解数据">For quantitative readers</span><h3 data-i18n-en="Inspect detailed results" data-i18n-zh="查看详细结果">Inspect detailed results</h3><p data-i18n-en="Open full tables, dates, labels, training settings, costs, and limitations." data-i18n-zh="查看完整表格、日期、标签、训练设置、成本和局限。">Open full tables, dates, labels, training settings, costs, and limitations.</p></a>
        <a class="card card-link" href={`${base}architecture/repository-boundaries/`}><span class="eyebrow" data-i18n-en="For contributors" data-i18n-zh="参与项目开发">For contributors</span><h3 data-i18n-en="Understand project boundaries" data-i18n-zh="了解项目边界">Understand project boundaries</h3><p data-i18n-en="See which repository owns data, models, artifacts, and backtest execution." data-i18n-zh="了解数据、模型、产物和回测运行分别由哪个仓库负责。">See which repository owns data, models, artifacts, and backtest execution.</p></a>
      </div>
      <p class="source-note" style="margin-top:1rem"><span>{publicDocuments.length}</span> <span data-i18n-en="reviewed technical and research documents are available from the documentation index." data-i18n-zh="篇经过审核的技术与研究文档可从文档索引中查阅。">reviewed technical and research documents are available from the documentation index.</span></p>
    </section>
  </div>
</SiteLayout>

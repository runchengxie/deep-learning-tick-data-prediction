---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Page not found"><section class="container study-hero"><span class="eyebrow" data-i18n-en="404 · Not found" data-i18n-zh="404 · 页面不存在">404 · Not found</span><h1 data-i18n-en="This page is not here." data-i18n-zh="这个页面不存在。">This page is not here.</h1><p class="muted" data-i18n-en="The link may have moved. Start from the research catalog or documentation index." data-i18n-zh="链接可能已变更。你可以从研究目录或文档索引重新开始。">The link may have moved. Start from the research catalog or documentation index.</p><div class="button-row"><a class="button primary" href={base} data-i18n-en="Research home" data-i18n-zh="研究首页">Research home</a><a class="button" href={`${base}documentation/`} data-i18n-en="Documentation" data-i18n-zh="技术文档">Documentation</a></div></section></SiteLayout>

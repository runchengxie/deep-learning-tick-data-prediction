---
import SiteLayout from '../../layouts/SiteLayout.astro';
import OrderBookLab from '../../components/OrderBookLab.astro';
import { copy } from '../../content/market-concepts.mjs';
const base=import.meta.env.BASE_URL;
const text=(key:keyof typeof copy)=>({ 'data-i18n-en':copy[key][0], 'data-i18n-zh':copy[key][1] });
---
<SiteLayout title="Orders, books and flow" description="Explore order messages, trades, MBP/MBO, order flow and Shanghai/Shenzhen data boundaries through synthetic interactive charts.">
  <article class="container concept-article">
    <header class="concept-heading"><p class="eyebrow" data-i18n-en={copy.sectionName[0]} data-i18n-zh={copy.sectionName[1]}>{copy.sectionName[0]}</p><h1 {...text('title')}>{copy.title[0]}</h1><p {...text('intro')}>{copy.intro[0]}</p><p class="warning" {...text('synthetic')}>{copy.synthetic[0]}</p></header>
    <section class="concept-section"><h2 {...text('concepts')}>{copy.concepts[0]}</h2><div class="concept-map" role="group" aria-label={copy.conceptMapLabel[0]} data-i18n-label-en={copy.conceptMapLabel[0]} data-i18n-label-zh={copy.conceptMapLabel[1]}><div class="map-events"><div {...text('orders')}>{copy.orders[0]}</div><div {...text('trades')}>{copy.trades[0]}</div></div><span aria-hidden="true">↓</span><div {...text('flow')}>{copy.flow[0]}</div><span aria-hidden="true">↓</span><div {...text('book')}>{copy.book[0]}</div></div><p {...text('relationship')}>{copy.relationship[0]}</p></section>
    <section class="concept-section"><h2 {...text('flowScope')}>{copy.flowScope[0]}</h2><div class="metric-map"><div {...text('broadFlow')}>{copy.broadFlow[0]}</div><div {...text('narrowFlow')}>{copy.narrowFlow[0]}</div></div><p {...text('flowScopeText')}>{copy.flowScopeText[0]}</p></section>
    <OrderBookLab kind="lifecycle" /><OrderBookLab kind="paths" /><OrderBookLab kind="noTrades" />
    <section class="concept-section"><h2 {...text('metrics')}>{copy.metrics[0]}</h2><div class="metric-map"><div><strong>OBI</strong><span data-i18n-en={copy.obiScope[0]} data-i18n-zh={copy.obiScope[1]}>{copy.obiScope[0]}</span></div><div><strong>OFI</strong><span data-i18n-en={copy.ofiScope[0]} data-i18n-zh={copy.ofiScope[1]}>{copy.ofiScope[0]}</span></div><div><strong>Delta / CVD</strong><span data-i18n-en={copy.deltaScope[0]} data-i18n-zh={copy.deltaScope[1]}>{copy.deltaScope[0]}</span></div></div><p {...text('metricText')}>{copy.metricText[0]}</p></section>
    <section class="concept-section"><h2 {...text('cautions')}>{copy.cautions[0]}</h2><p {...text('venueText')}>{copy.venueText[0]}</p><div class="venue-timeline"><div><strong>2021 / 05</strong><span data-i18n-en={copy.orderLaunch[0]} data-i18n-zh={copy.orderLaunch[1]}>{copy.orderLaunch[0]}</span></div><div><strong>2023 / 11 / 27</strong><span data-i18n-en={copy.combinedLaunch[0]} data-i18n-zh={copy.combinedLaunch[1]}>{copy.combinedLaunch[0]}</span></div></div><p {...text('dateText')}>{copy.dateText[0]}</p><p class="warning" {...text('limits')}>{copy.limits[0]}</p><a href={`${base}research/shanghai-opening-contract-audit-2026-08-27/`} {...text('audit')}>{copy.audit[0]}</a></section>
    <section class="concept-section"><h2 {...text('splitting')}>{copy.splitting[0]}</h2><div class="concept-map"><div {...text('parent')}>{copy.parent[0]}</div><span aria-hidden="true">↓</span><div {...text('children')}>{copy.children[0]}</div><div {...text('fills')}>{copy.fills[0]}</div><div {...text('aggregation')}>{copy.aggregation[0]}</div></div><p {...text('splittingText')}>{copy.splittingText[0]}</p></section>
    <section class="concept-section"><h2 {...text('models')}>{copy.models[0]}</h2><p {...text('modelText')}>{copy.modelText[0]}</p><div class="model-map"><a href={`${base}nextday/raw-200-end-to-end-pipeline/`} data-i18n-en={copy.snapshotModel[0]} data-i18n-zh={copy.snapshotModel[1]}>{copy.snapshotModel[0]}</a><a href={`${base}nextday/eventstream/`} data-i18n-en={copy.eventModel[0]} data-i18n-zh={copy.eventModel[1]}>{copy.eventModel[0]}</a></div></section>
    <section class="concept-section"><h2 {...text('read')}>{copy.read[0]}</h2><ul><li><a href={`${base}concepts/orders-books-and-flow/`} data-i18n-en={copy.guideLink[0]} data-i18n-zh={copy.guideLink[1]}>{copy.guideLink[0]}</a></li><li><a href="https://www.sseinfo.com/aboutus/events/" data-i18n-en={copy.historySource[0]} data-i18n-zh={copy.historySource[1]}>{copy.historySource[0]}</a></li><li><a href="https://arxiv.org/abs/1011.6402" data-i18n-en={copy.paperSource[0]} data-i18n-zh={copy.paperSource[1]}>{copy.paperSource[0]}</a></li></ul></section>
  </article>
</SiteLayout>

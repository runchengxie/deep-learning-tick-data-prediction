---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EvidenceBars from '../../components/EvidenceBars.astro';
import StudyReport from '../../components/StudyReport.astro';
import { studies } from '../../content/studies.mjs';
import { studyReports } from '../../content/study-reports.mjs';
import { readerCopy } from '../../content/reader-copy.mjs';
const { id } = Astro.params;
const study = studies.find((item) => item.id === id);
if (!study) throw new Error(`Unknown study: ${id}`);
const base = import.meta.env.BASE_URL;
const sourceRoute = `/${study.source.replace(/^docs\//, '').replace(/\.md$/, '')}/`;
export function getStaticPaths() { return studies.map((study) => ({ params: { id: study.id } })); }
---
<SiteLayout title={study.title} description={study.summary}>
  <div class="container">
    <section class="study-hero"><span class="status" data-i18n-en={study.stage} data-i18n-zh={study.zh.stage}>{study.stage}</span><h1 data-i18n-en={study.title} data-i18n-zh={study.zh.title}>{study.title}</h1><p class="muted" data-i18n-en={study.summary} data-i18n-zh={study.zh.summary}>{study.summary}</p><div class="study-meta"><span data-i18n-en={study.sample} data-i18n-zh={study.zh.sample}>{study.sample}</span><span data-i18n-en={`Source cutoff: ${study.source.includes('project-status') ? '2026-08-29' : 'see source record'}`} data-i18n-zh={`来源记录截止：${study.source.includes('project-status') ? '2026-08-29' : '请见原始记录'}`}>Source cutoff: {study.source.includes('project-status') ? '2026-08-29' : 'see source record'}</span></div></section>
    <div class="study-layout">
      <article class="study-copy">
        <details><summary data-i18n-en="Terms used in this study" data-i18n-zh="本页术语说明">Terms used in this study</summary><p data-i18n-en={readerCopy.terms[0]} data-i18n-zh={readerCopy.terms[1]}>{readerCopy.terms[0]}</p></details>
        <h2 data-i18n-en="What was tested?" data-i18n-zh="测试了什么？">What was tested?</h2>
        <p data-i18n-en={study.id === 'event-stream-ranking' ? 'A causal Transformer reads order, trade, and snapshot events in sequence. Three separately trained 100M-parameter models were tested on the following month; training and checkpoint selection used only earlier periods.' : study.id === 'raw-order-book-capacity' ? 'A controlled four-setting comparison varied model size and input length. Each setting used three random seeds, a Top-100 universe, and the same validation period.' : 'We evaluated minute features on rolling out-of-sample periods. A later formal study also tested 64 portfolio and buffer settings at an assumed one-way cost of 10 basis points.'} data-i18n-zh={study.id === 'event-stream-ranking' ? '因果 Transformer 按时间顺序读取委托、成交和盘口快照事件。三个分别训练的 1 亿参数模型在下一个月进行测试；训练和检查点选择只使用更早的时间段。' : study.id === 'raw-order-book-capacity' ? '受控对比共设四种配置，分别改变模型规模和输入长度。每种配置使用三个随机种子、Top-100 股票池和相同的验证期。' : '我们在滚动样本外区间评估分钟特征。后续一项正式研究还在假设单边成本为 10 个基点时，测试了 64 种组合和缓冲区设置。'}>{study.id === 'event-stream-ranking' ? 'A causal Transformer reads order, trade, and snapshot events in sequence. Three separately trained 100M-parameter models were tested on the following month; training and checkpoint selection used only earlier periods.' : study.id === 'raw-order-book-capacity' ? 'A controlled four-setting comparison varied model size and input length. Each setting used three random seeds, a Top-100 universe, and the same validation period.' : 'We evaluated minute features on rolling out-of-sample periods. A later formal study also tested 64 portfolio and buffer settings at an assumed one-way cost of 10 basis points.'}</p>
        <h2 data-i18n-en="What does the chart mean?" data-i18n-zh="图表表示什么？">What does the chart mean?</h2>
        <p data-i18n-en="Rank IC compares the ranking of model scores with the ranking of later returns across stocks. A value above zero means the two rankings tended to move together in this sample. Rank IC does not measure portfolio returns or account for all portfolio constraints." data-i18n-zh="Rank IC 比较模型分数排序与股票后续收益排序。数值大于零，表示在该样本中两种排序总体趋于一致。Rank IC 不衡量组合收益，也没有考虑所有组合约束。">Rank IC compares the ranking of model scores with the ranking of later returns across stocks. A value above zero means the two rankings tended to move together in this sample. Rank IC does not measure portfolio returns or account for all portfolio constraints.</p>
        <h2 data-i18n-en="What remains open?" data-i18n-zh="还有哪些问题？">What remains open?</h2>
        <p data-i18n-en={study.openQuestion} data-i18n-zh={study.zh.openQuestion}>{study.openQuestion}</p>
        {study.id === 'event-stream-ranking' && <div class="warning"><strong data-i18n-en="Trading value remains unresolved." data-i18n-zh="交易价值仍未得到证实。">Trading value remains unresolved.</strong> <span data-i18n-en="In a separate joint-model evaluation, OOS Rank IC was 0.06398 ± 0.00785, while mean daily Top-100 active return after costs was −9.67 ± 3.71 basis points. That evaluation used a different sample and model setup from the chart above; consult the source record before comparing the results." data-i18n-zh="另一项联合模型评估中，样本外 Rank IC 为 0.06398 ± 0.00785，计入成本后的 Top-100 日均超额收益为 −9.67 ± 3.71 个基点。这项评估的样本和模型设置与图表不同；比较结果前请先查看来源记录。">In a separate joint-model evaluation, OOS Rank IC was 0.06398 ± 0.00785, while mean daily Top-100 active return after costs was −9.67 ± 3.71 basis points. That evaluation used a different sample and model setup from the chart above; consult the source record before comparing the results.</span></div>}
        {study.id === 'minute-baselines' && <div class="warning"><strong data-i18n-en="Historical signal is not a cost pass." data-i18n-zh="历史信号尚未通过成本检验。">Historical signal is not a cost pass.</strong> <span data-i18n-en="The 2025 H2 formal matrix found no tested region meeting the pre-set 10 bp one-way cost gate, despite positive monthly Rank IC in the six-month sample." data-i18n-zh="尽管六个月样本中的月度Rank IC为正，2025年下半年的正式矩阵测试中，没有任何区域达到预设的单边10个基点成本门槛。">The 2025 H2 formal matrix found no tested region meeting the pre-set 10 bp one-way cost gate, despite positive monthly Rank IC in the six-month sample.</span></div>}
      </article>
      <EvidenceBars title={study.chartTitle} description={study.chartDescription} metric={study.metric} titleZh={study.zh.chartTitle} descriptionZh={study.zh.chartDescription} metricZh={study.zh.metric} valueLabelsZh={study.zh.values} max={study.max} values={study.values} source={`${base}${sourceRoute.replace(/^\//, '')}`} />
    </div>
    <StudyReport report={studyReports[study.id as keyof typeof studyReports]} base={base} />
  </div>
</SiteLayout>

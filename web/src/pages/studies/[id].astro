---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EvidenceBars from '../../components/EvidenceBars.astro';
import { studies } from '../../content/studies.mjs';
const { id } = Astro.params;
const study = studies.find((item) => item.id === id);
if (!study) throw new Error(`Unknown study: ${id}`);
const base = import.meta.env.BASE_URL;
const sourceRoute = `/${study.source.replace(/^docs\//, '').replace(/\.md$/, '')}/`;
export function getStaticPaths() { return studies.map((study) => ({ params: { id: study.id } })); }
---
<SiteLayout title={study.title} description={study.summary}>
  <div class="container">
    <section class="study-hero"><span class="status" data-i18n-en={study.stage} data-i18n-zh={study.zh.stage}>{study.stage}</span><h1 data-i18n-en={study.title} data-i18n-zh={study.zh.title}>{study.title}</h1><p class="muted" data-i18n-en={study.summary} data-i18n-zh={study.zh.summary}>{study.summary}</p><div class="study-meta"><span data-i18n-en={study.sample} data-i18n-zh={study.zh.sample}>{study.sample}</span><span data-i18n-en={`Source cutoff: ${study.source.includes('project-status') ? '2026-08-29' : 'see source record'}`} data-i18n-zh={`来源记录截止：${study.source.includes('project-status') ? '2026-08-29' : '请见原始记录'}`}>Source cutoff: {study.source.includes('project-status') ? '2026-08-29' : 'see source record'}</span></div></section>
    <div class="study-layout">
      <article class="study-copy">
        <h2 data-i18n-en="What was tested?" data-i18n-zh="测试了什么？">What was tested?</h2>
        <p data-i18n-en={study.id === 'event-stream-ranking' ? 'A causal Transformer reads ordered order, trade, and snapshot events. Three separately trained 100M-parameter models were evaluated on the next month, after training and checkpoint choices were made using earlier periods.' : study.id === 'raw-order-book-capacity' ? 'The comparison changed model capacity and input length in a controlled four-cell design. Each cell used three random seeds, a Top-100 universe, and the same validation period.' : 'Minute features were tested with rolling out-of-sample evaluation. A later formal study also evaluated 64 portfolio and buffer combinations against a 10 basis-point one-way cost assumption.'} data-i18n-zh={study.id === 'event-stream-ranking' ? '因果Transformer按顺序读取委托、成交和盘口快照事件。三个分别训练的1亿参数模型在下一个月进行评估；训练和检查点选择只使用更早的时间段。' : study.id === 'raw-order-book-capacity' ? '对比采用四组受控实验，分别改变模型规模和输入长度。每组使用三个随机种子、Top-100股票池和相同验证期。' : '分钟特征采用滚动样本外评估。后续正式研究还在单边成本假设为10个基点的条件下，评估了64种组合和缓冲区设置。'}>{study.id === 'event-stream-ranking' ? 'A causal Transformer reads ordered order, trade, and snapshot events. Three separately trained 100M-parameter models were evaluated on the next month, after training and checkpoint choices were made using earlier periods.' : study.id === 'raw-order-book-capacity' ? 'The comparison changed model capacity and input length in a controlled four-cell design. Each cell used three random seeds, a Top-100 universe, and the same validation period.' : 'Minute features were tested with rolling out-of-sample evaluation. A later formal study also evaluated 64 portfolio and buffer combinations against a 10 basis-point one-way cost assumption.'}</p>
        <h2 data-i18n-en="What does the chart mean?" data-i18n-zh="图表表示什么？">What does the chart mean?</h2>
        <p data-i18n-en="Rank IC compares the ordering of model scores with the ordering of later returns across stocks. Values above zero indicate that the rankings tended to align in this sample. They do not show the size of an investable return and do not include all portfolio constraints." data-i18n-zh="Rank IC比较模型分数的排序与股票后续收益的排序。数值大于零表示在该样本中两种排序总体一致，但它不代表可投资收益的幅度，也没有纳入全部组合约束。">Rank IC compares the ordering of model scores with the ordering of later returns across stocks. Values above zero indicate that the rankings tended to align in this sample. They do not show the size of an investable return and do not include all portfolio constraints.</p>
        <h2 data-i18n-en="What remains open?" data-i18n-zh="还有哪些问题？">What remains open?</h2>
        <p data-i18n-en={study.openQuestion} data-i18n-zh={study.zh.openQuestion}>{study.openQuestion}</p>
        {study.id === 'event-stream-ranking' && <div class="warning"><strong data-i18n-en="Trading conversion remains unresolved." data-i18n-zh="能否转化为交易收益仍未解决。">Trading conversion remains unresolved.</strong> <span data-i18n-en="In the separate joint-model evaluation, OOS Rank IC was 0.06398 ± 0.00785 while mean daily Top-100 active return after costs was −9.67 ± 3.71 basis points. The samples and model setup differ from the chart above; read the source before comparing them." data-i18n-zh="另一项联合模型评估中，样本外Rank IC为0.06398 ± 0.00785，而计入成本后的Top-100日均超额收益为−9.67 ± 3.71个基点。该评估与上图的样本和模型设置不同，比较前请阅读来源记录。">In the separate joint-model evaluation, OOS Rank IC was 0.06398 ± 0.00785 while mean daily Top-100 active return after costs was −9.67 ± 3.71 basis points. The samples and model setup differ from the chart above; read the source before comparing them.</span></div>}
        {study.id === 'minute-baselines' && <div class="warning"><strong data-i18n-en="Historical signal is not a cost pass." data-i18n-zh="历史信号尚未通过成本检验。">Historical signal is not a cost pass.</strong> <span data-i18n-en="The 2025 H2 formal matrix found no tested region meeting the pre-set 10 bp one-way cost gate, despite positive monthly Rank IC in the six-month sample." data-i18n-zh="尽管六个月样本中的月度Rank IC为正，2025年下半年的正式矩阵测试中，没有任何区域达到预设的单边10个基点成本门槛。">The 2025 H2 formal matrix found no tested region meeting the pre-set 10 bp one-way cost gate, despite positive monthly Rank IC in the six-month sample.</span></div>}
        <p style="margin-top:1.5rem"><a href={`${base}${sourceRoute.replace(/^\//, '')}`} data-i18n-en="Read the complete research record →" data-i18n-zh="阅读完整研究记录 →">Read the complete research record →</a></p>
      </article>
      <EvidenceBars title={study.chartTitle} description={study.chartDescription} metric={study.metric} titleZh={study.zh.chartTitle} descriptionZh={study.zh.chartDescription} metricZh={study.zh.metric} valueLabelsZh={study.zh.values} max={study.max} values={study.values} source={`${base}${sourceRoute.replace(/^\//, '')}`} />
    </div>
  </div>
</SiteLayout>

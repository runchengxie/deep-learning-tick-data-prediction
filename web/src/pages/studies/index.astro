---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { studies } from '../../content/studies.mjs';
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Research studies">
  <section class="container study-hero"><span class="eyebrow" data-i18n-en="Research catalog" data-i18n-zh="研究目录">Research catalog</span><h1 data-i18n-en="What have we tested?" data-i18n-zh="我们测试了什么？">What have we tested?</h1><p class="muted" data-i18n-en="Each study card includes the question, evidence stage, data window, main observation, and what is still unknown." data-i18n-zh="每张研究卡片都会说明研究问题、证据阶段、数据区间、主要发现和仍待回答的问题。">Each study card includes the question, evidence stage, data window, main observation, and what is still unknown.</p></section>
  <section class="container section"><div class="grid-3">{studies.map((study) => <a class="card card-link" href={`${base}studies/${study.id}/`}><span class="status" data-i18n-en={study.stage} data-i18n-zh={study.zh.stage}>{study.stage}</span><h3 data-i18n-en={study.title} data-i18n-zh={study.zh.title}>{study.title}</h3><p data-i18n-en={study.summary} data-i18n-zh={study.zh.summary}>{study.summary}</p><span class="source-note" data-i18n-en={study.sample} data-i18n-zh={study.zh.sample}>{study.sample}</span></a>)}</div></section>
</SiteLayout>

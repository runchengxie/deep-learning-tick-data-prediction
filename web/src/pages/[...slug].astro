---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { publicDocuments, documentSlug } from '../content/public-documents.mjs';
import { rewritePublicLinks } from '../content/public-links.mjs';

export function getStaticPaths() {
  return publicDocuments.map((source) => ({ params: { slug: documentSlug(source) }, props: { source } }));
}

const { source } = Astro.props;
if (!publicDocuments.includes(source)) throw new Error(`Document is not publicly allowlisted: ${source}`);
const repoRoot = path.resolve(process.cwd(), '..');
const fullPath = path.resolve(repoRoot, source);
const docsRoot = path.resolve(repoRoot, 'docs') + path.sep;
if (!fullPath.startsWith(docsRoot)) throw new Error(`Public document escaped docs/: ${source}`);
const markdown = await readFile(fullPath, 'utf8');
const heading = markdown.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? source;
const paragraphs = markdown.split(/\n\s*\n/).map((part) => part.trim()).filter((part) => part && !part.startsWith('#') && !part.startsWith('[') && !part.startsWith('|'));
const description = paragraphs[0]?.replace(/[*`_]/g, '').slice(0, 240) ?? 'Project documentation and research record.';
const processor = await createMarkdownProcessor({ rehypePlugins: [[rewritePublicLinks, { source, base: import.meta.env.BASE_URL }]] });
const rendered = await processor.render(markdown, { fileURL: pathToFileURL(fullPath) });
---
<ArticleLayout title={source === 'docs/index.md' ? 'Documentation and research records' : heading} description={description} source={source} html={rendered.code} headings={rendered.metadata.headings} />
